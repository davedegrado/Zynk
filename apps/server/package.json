{
  "name": "@zynk/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "esbuild src/index.ts src/cli.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist --sourcemap --external:fastify --external:@fastify/* --external:pg --external:zod && node -e \"require('fs').cpSync('migrations','dist/migrations',{recursive:true})\"",
    "migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
