# Copy to apps/server/.env for local development.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://zynk:zynk@localhost:5432/zynk
# Base URL used for invite links (https://<domain>/i/<code>)
PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info

# Push: expo | log (prints instead of sending) | none
PUSH_PROVIDER=log
# Optional: required only if "Enhanced push security" is enabled for your Expo project
# EXPO_ACCESS_TOKEN=

# Purchases (RevenueCat). Leave unset to run without purchases — the app stays fully usable for free users.
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_WEBHOOK_AUTH=<long random string, also set in RevenueCat webhook "Authorization header">
# REVENUECAT_ENTITLEMENT_ID=plus
# PLANS_JSON=[{"id":"plus_monthly","productIds":{"ios":"zynk_plus_monthly","android":"zynk_plus:monthly"},"period":"P1M","entitlement":"plus","fallbackPrice":{"amount":1.99,"currency":"EUR","display":"€1.99"}}]
# PROMO_MESSAGE=

# Anti-abuse limits (not monetization)
# ZYNK_PAIR_COOLDOWN_MS=2000
# ZYNK_PAIR_MAX_PER_MINUTE=12
# ZYNK_SENDER_MAX_PER_MINUTE=60
# ZYNK_SENDER_MAX_PER_HOUR=600
# ZYNK_PUSH_COLLAPSE_MS=10000
# FRIEND_REQUESTS_MAX_PER_HOUR=40
# REPORTS_MAX_PER_DAY=20

# Retention
# ZYNK_RETENTION_DAYS=180

# Moderation API (disabled when unset; min 24 chars)
# ADMIN_API_TOKEN=
