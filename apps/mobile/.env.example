# Backend base URL. In development, defaults to http://<metro-host>:4000.
EXPO_PUBLIC_API_URL=
# Public URL used when sharing invite links (should match the server's PUBLIC_URL).
EXPO_PUBLIC_INVITE_BASE_URL=
# RevenueCat *public* SDK keys (safe to ship in the app). Leave empty to disable purchases.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# EAS project id (required for Expo push tokens in builds).
EAS_PROJECT_ID=
# Links shown on the subscription screen (required by App Store review).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
